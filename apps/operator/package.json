{
  "name": "@tournament/operator",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "description": "Tournament operator desktop application",
  "author": "Tournament",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "vite build",
    "preview": "vite preview --port 4174",
    "lint": "node -e \"process.exit(0)\"",
    "clean:desktop": "node -e \"require('fs').rmSync('release', { recursive: true, force: true })\"",
    "build:desktop": "npm run clean:desktop && cross-env VITE_ELECTRON=1 vite build && electron-builder --win nsis --publish never",
    "pack:desktop": "cross-env VITE_ELECTRON=1 vite build && electron-builder --win dir --publish never",
    "publish:desktop": "node ../../scripts/publish-desktop-update.mjs",
    "publish:desktop:check": "node ../../scripts/publish-desktop-update.mjs --check",
    "release:win": "npm run build:desktop && npm run publish:desktop",
    "test": "node --test electron/updatePolicy.test.cjs src/excelImportExport.test.js"
  },
  "dependencies": {
    "@tournament/client": "*",
    "@tournament/engine": "*",
    "@tournament/ui": "*",
    "electron-updater": "^6.6.2",
    "lucide-react": "^1.41.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "^7.0.3",
    "electron": "38.8.6",
    "electron-builder": "^26.0.12",
    "eslint": "^10.6.0",
    "png-to-ico": "^3.0.2",
    "vite": "^8.1.1"
  },
  "build": {
    "appId": "app.tournament.operator",
    "productName": "Tournament Operator",
    "copyright": "Tournament",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "electronVersion": "38.8.6",
    "npmRebuild": false,
    "electronLanguages": [
      "en-US"
    ],
    "icon": "build/icon.ico",
    "publish": {
      "provider": "github",
      "owner": "jmdg840",
      "repo": "tournament-operator-updates",
      "releaseType": "release"
    },
    "protocols": [
      {
        "name": "Tournament Operator",
        "schemes": [
          "tournament-operator"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Tournament-Operator-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Tournament Operator",
      "include": "build/installer.nsh"
    }
  }
}
