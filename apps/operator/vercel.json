{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --prefix ../.. --ignore-scripts",
  "buildCommand": "npm run build --prefix ../.. -w @tournament/operator",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/live/:slug", "destination": "/index.html" }
  ]
}

