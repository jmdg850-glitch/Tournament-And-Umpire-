VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_ANON_KEY=
VITE_COMMAND_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/command

# Windows Operator auto-update: checks GitHub Releases on the source repo
# itself (jmdg850-glitch/Tournament-And-Umpire-, already public). Public repo,
# so no token/env var is needed at runtime to check or download updates. See
# apps/operator/electron/updatePolicy.cjs and scripts/publish-desktop-update.mjs.
#
# Legacy: builds published before this repo consolidated onto a single
# repository checked jmdg840/tournament-operator-updates (a separate,
# releases-only repo, no app source). That repo is untouched and still serves
# auto-update checks for any already-installed copy of those older builds —
# it is not used by new builds or this release process. See the root
# .env.example for the fuller note.
