VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_ANON_KEY=
VITE_COMMAND_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/command

# Windows Operator auto-update: checks GitHub Releases on
# jmdg840/tournament-operator-updates (a releases-only repo, no app source).
# Public repo, so no token/env var is needed at runtime to check or download
# updates. See apps/operator/electron/updatePolicy.cjs and
# scripts/publish-desktop-update.mjs.
