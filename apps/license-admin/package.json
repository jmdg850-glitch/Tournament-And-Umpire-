{
  "name": "@tournament/license-admin",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Tournament",
  "description": "Tournament License Admin - seller console: issue an access code per customer email, revoke, release a PC",
  "scripts": {
    "dev": "vite --port 5176",
    "build": "vite build",
    "preview": "vite preview --port 4176",
    "lint": "node -e \"process.exit(0)\"",
    "test": "vitest run",
    "clean:desktop": "node -e \"require('fs').rmSync('release', { recursive: true, force: true })\"",
    "build:desktop": "npm run clean:desktop && cross-env VITE_ELECTRON=1 vite build && node ../../scripts/build-desktop-win.mjs",
    "build:android": "cross-env CAPACITOR=1 vite build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@tournament/client": "*",
    "electron-updater": "^6.6.2",
    "lucide-react": "^1.41.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "^7.0.3",
    "electron": "38.8.6",
    "electron-builder": "^26.0.12",
    "jsdom": "^25.0.1",
    "png-to-ico": "^3.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "app.tournament.licenseadmin",
    "productName": "Tournament License Admin",
    "copyright": "Tournament",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "build/icon.ico", "package.json"],
    "electronVersion": "38.8.6",
    "npmRebuild": false,
    "electronLanguages": ["en-US"],
    "icon": "build/icon.ico",
    "publish": {
      "provider": "github",
      "owner": "jmdg850-glitch",
      "repo": "Tournament-And-Umpire-",
      "releaseType": "release",
      "channel": "license-admin"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "Tournament-License-Admin-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Tournament License Admin"
    }
  }
}
