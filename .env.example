# Client-safe (browser apps)

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy alias still accepted by the client:
# VITE_SUPABASE_ANON_KEY=eyJ...
VITE_COMMAND_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/command

# Server-only — packages/api and CI. NEVER prefix with VITE_.
# NEVER commit the real values.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Privileged key used by packages/api.
# Use whichever your Supabase project currently issues — only ONE is needed:
SUPABASE_SERVICE_ROLE_KEY=legacy_service_role_jwt_or_leave_blank
SUPABASE_SECRET_KEY=sb_secret_..._or_leave_blank
COMMAND_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/command
# Device JWT for court stations. Server-only. Generate a long random string.
STATION_JWT_SECRET=
PORT=8787

# Set to 1 to run packages/api live integration tests against the seeded DB.
# RUN_LIVE_API_TESTS=1

# --- Windows desktop update publishing (scripts/publish-desktop-update.mjs) ---
# Publishes to a GitHub Release (repo: jmdg840/tournament-operator-updates —
# releases-only, no app source). No env var here controls auth: the script
# shells out to the `gh` CLI, which resolves credentials itself via
# `gh auth login` or a GH_TOKEN / GITHUB_TOKEN variable already in your shell.
# Never put a token in this file or any committed file.
# Verify first with: npm run publish:desktop:check -w @tournament/operator
